{
  "manifest_version": 3,
  "name": "Aviator Browser Collector",
  "version": "0.1.0",
  "description": "Captures client-visible SmartFox extensionResponse events from Aviator game 52358.",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://1xlite-130003.top/*",
    "https://aviator-next.spribegaming.com/*",
    "https://*.up.railway.app/*",
    "http://127.0.0.1/*",
    "http://localhost/*"
  ],
  "background": {
    "service_worker": "service_worker.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://1xlite-130003.top/*",
        "https://aviator-next.spribegaming.com/*"
      ],
      "js": [
        "page_hook.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://1xlite-130003.top/*",
        "https://aviator-next.spribegaming.com/*"
      ],
      "js": [
        "bridge.js"
      ],
      "run_at": "document_start",
      "world": "ISOLATED"
    }
  ],
  "options_page": "options.html"
}
